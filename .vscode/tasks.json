{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Home Assistant on port 9123",
            "type": "shell",
            "command": ".venv/bin/hass -c .devcontainer",
            "problemMatcher": []
        },
        {
            "label": "Check Home Assistant configuration",
            "type": "shell",
            "command": ".venv/bin/hass -c .devcontainer --script check_config",
            "problemMatcher": []
        },
        {
            "label": "Lint integration",
            "type": "shell",
            "command": ".venv/bin/flake8 custom_components/teamspeak && .venv/bin/isort --check-only custom_components/teamspeak && .venv/bin/black --check custom_components/teamspeak",
            "problemMatcher": []
        }
    ]
}
