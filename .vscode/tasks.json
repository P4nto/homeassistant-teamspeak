        },
        {
            "label": "Check Home Assistant configuration",
            "type": "shell",
            "command": ".venv/bin/hass -c .devcontainer --script check_config",
            "problemMatcher": []
        },
        {
            "label": "Lint integration",
            "type": "shell",
            "command": ".venv/bin/ruff check . && .venv/bin/ruff format --check .",
            "problemMatcher": []
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": ".venv/bin/pytest",
            "problemMatcher": []
        }
    ]
}
